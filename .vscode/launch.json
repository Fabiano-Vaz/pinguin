{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Executar Pinguim Pet",
      "type": "extensionHost",
      "request": "launch",
      "args": [
        "--extensionDevelopmentPath=${workspaceFolder}",
        "--disable-extensions",
        "--new-window"
      ],
      "preLaunchTask": "Pinguim: compilar",
      "outFiles": [
        "${workspaceFolder}/dist/**/*.js"
      ]
    }
  ]
}
